{
    "name": "@biaspay/elements",
    "version": "0.1.1",
    "private": false,
    "description": "Framework-neutral Bias payment custom elements",
    "keywords": [
        "payments",
        "custom-elements",
        "web-components"
    ],
    "homepage": "https://biaspay.com",
    "bugs": {
        "url": "https://github.com/BiasPay/elements/issues"
    },
    "license": "MIT",
    "author": "Bias",
    "contributors": [],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BiasPay/elements.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": [
        "**/*.css",
        "./dist/index.js",
        "./dist/development.js"
    ],
    "scripts": {
        "dev": "vite serve --config dev/vite.config.ts dev --port 3010",
        "build": "bun run build:prod && bun run build:dev",
        "build:prod": "rm -rf dist && vite build && bun scripts/assert-artifact.ts production dist/*.js && bun run build:types",
        "build:dev": "vite build --mode development && bun scripts/assert-artifact.ts development dist/development.js dist/development/*.js && bun run build:types",
        "build:types": "tsc -p tsconfig.types.json && bun scripts/copy-types.ts",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "test": "bun run test:core && bun run test:web",
        "test:core": "vitest run --config vitest.core.config.ts",
        "test:web": "vitest run",
        "test:watch": "vitest",
        "prepack": "bun run build:prod"
    },
    "dependencies": {
        "@biaspay/sdk": "2.0.0",
        "@steeze-ui/heroicons": "^2.4.2",
        "@steeze-ui/svelte-icon": "^1.6.2",
        "bezier-easing": "^3.1.0",
        "libphonenumber-js": "^1.13.14",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@biaspay/sdk-checkout": "file:./vendor/sdk-checkout",
        "@sveltejs/package": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.4",
        "@vitest/browser": "^5.0.3",
        "@vitest/browser-playwright": "^5.0.3",
        "jsdom": "^30.1.2",
        "playwright": "^1.63.0",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "svelte-tweakpane-ui": "^1.6.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.3",
        "vite-plugin-css-injected-by-js": "^5.0.2",
        "vitest": "^5.0.3"
    },
    "engines": {
        "bun": ">=1.3.11",
        "node": ">=18"
    }
}
